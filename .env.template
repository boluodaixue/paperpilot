# =============================================================================
# DeepResearch Agent — 多后端 LLM 配置文件
# =============================================================================
# 用法：
#   1. 复制本文件为 .env.local（已被 .gitignore 忽略，不会提交到 Git）
#   2. 填入你的真实 API Key
#   3. 系统启动时自动读取，无需修改源码
# =============================================================================
#
# 【设计原则】
#   .env 只存"连接信息"（API Key、Base URL、Model 名）。
#   采样参数（temperature、max_tokens）由 configs/default.yaml 按模块配置，
#   通过 ModelRouter.create_backend(name, temperature=..., max_tokens=...) 动态覆盖。
# =============================================================================

# ---------------------------------------------------------------------------
# Langfuse 追踪配置（可选）
# ---------------------------------------------------------------------------
# 项目级开关。只有开关为 true 且公私钥齐全时才启用；否则自动降级为无追踪。
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# 按你的 Langfuse Cloud 区域或自托管地址修改
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 环境、发布版本和采样率用于筛选及成本控制
LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=git-sha-or-version
LANGFUSE_SAMPLE_RATE=1.0
# 普通 Agent/Chain 装饰器默认不上传完整入参与返回值；LLM 调用仍由 OpenAI 集成记录。
LANGFUSE_OBSERVE_DECORATOR_IO_CAPTURE_ENABLED=false

# ---------------------------------------------------------------------------
# 默认后端选择
# ---------------------------------------------------------------------------
# 可选值: deepseek | vllm | openai | mimo
# 与 configs/default.yaml 保持一致，默认使用 deepseek
DEFAULT_LLM_BACKEND=deepseek

# ---------------------------------------------------------------------------
# DeepSeek API 配置（仅连接信息）
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_ss_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# 本地 vLLM 配置（仅连接信息）
# ---------------------------------------------------------------------------
# VLLM_API_KEY=EMPTY
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------------------------------------------------------------------------
# OpenAI / 其他 OpenAI 兼容 API（可选）
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Xiaomi MiMo 2.5 Pro（OpenAI 兼容）
# ---------------------------------------------------------------------------
MIMO_API_KEY=your_ss_key_here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Web Search 工具配置
# ---------------------------------------------------------------------------
# 首选 Tavily；失败时只尝试已配置的备用源，无需部署常驻服务。
SEARCH_BACKEND=tavily
SEARCH_FALLBACK_BACKENDS=tavily,metaso,exa,bocha,serpapi

# --- Tavily（推荐首选，面向研究 Agent）---
# https://app.tavily.com/ 注册并创建 Key
TAVILY_API_KEY=your_tavily_key_here
TAVILY_API_ENDPOINT=https://api.tavily.com/search

# --- Exa（可选，语义搜索与正文片段）---
# https://dashboard.exa.ai/api-keys
# EXA_API_KEY=your_exa_key_here
# EXA_API_ENDPOINT=https://api.exa.ai/search

# --- SerpAPI（可选备用源）---
# 在 https://serpapi.com 注册获取 Key
# SERPAPI_KEY=your_ss_key_here
# SERPAPI_ENDPOINT=https://serpapi.com/search

# 博查AI 搜索配置（✅ 国内最优，面向 AI Agent 优化）
# ---------------------------------------------------------------------------
# BOCHA_API_KEY=your_bocha_key_here
# BOCHA_API_ENDPOINT=https://api.bochaai.com/v1/web-search

# ---------------------------------------------------------------------------
# 秘塔AI 搜索配置（✅ 中文语义强，支持 research 多轮模式）
# ---------------------------------------------------------------------------
# METASO_API_KEY=your_metaso_key_here
# METASO_API_ENDPOINT=https://metaso.cn/api/v1/search


# ---------------------------------------------------------------------------
# ArXiv / 论文阅读 工具配置
# ---------------------------------------------------------------------------
# 首选后端：semantic_scholar | arxiv | openalex；失败或空结果会自动回退
# 裸 arXiv ID 会优先走 arXiv，再回退到 Semantic Scholar 和 OpenAlex。
ARXIV_READER_BACKEND=openalex

# --- Semantic Scholar 配置（✅ 国内可达，推荐）---
# 免费申请 Key（可选，无 Key 有 rate limit）：
# https://www.semanticscholar.org/product/api#api-key-form
# SEMANTIC_SCHOLAR_API_KEY=your_ss_key_here
# --- ArXiv 配置（公开 API；程序使用可信 CA 验证 TLS）---
# ARXIV_API_ENDPOINT=http://export.arxiv.org/api/query
# --- OpenAlex 配置（基础使用免费；免费 Key 可提高日额度）---
# https://help.openalex.org/api/authentication/
# OPENALEX_API_KEY=your_openalex_key_here
OPENALEX_EMAIL=your_email_here


# ---------------------------------------------------------------------------
# Browser 工具配置（✅ 纯 HTTP 抓取，国内可用性取决于目标网站）
# ---------------------------------------------------------------------------
# HTTP 请求超时（秒）
BROWSER_TIMEOUT=15

# 自定义 User-Agent（某些网站需要特定 UA）
# BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ---------------------------------------------------------------------------
# Code Sandbox 工具配置（✅ 纯本地，无网络）
# ---------------------------------------------------------------------------
# 默认执行超时（秒）
CODE_SANDBOX_TIMEOUT=10

# HuggingFace 国内镜像（避免连接 huggingface.co 超时，同时支持下载新模型）
HF_ENDPOINT=https://hf-mirror.com

