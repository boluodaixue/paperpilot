{
  "chat": {
    "db_path": "data/chat.db"
  },
  "content_extraction": {
    "docling_enabled": false,
    "max_blocks": 24,
    "max_download_bytes": 12000000,
    "max_output_chars": 24000,
    "mode": "structured",
    "ocr_enabled": false,
    "tavily_extract_fallback": true
  },
  "model": {
    "backend": "deepseek",
    "backend_mapping": {
      "judge": "deepseek",
      "research": "deepseek"
    },
    "backend_sampling": {
      "deepseek": {
        "max_tokens": 4096,
        "temperature": 0.7,
        "top_p": 1.0
      },
      "modules": {
        "judge": {
          "max_tokens": 2048,
          "temperature": 0.1
        },
        "research": {
          "max_input_chars": 60000,
          "max_tokens": 4096,
          "temperature": 0.3
        }
      }
    }
  },
  "research": {
    "architecture": "legacy",
    "homogeneous_fork": {
      "budget_leases_enabled": true,
      "child_topup_tokens": 25000,
      "enabled": true,
      "explicit_control_decision": true,
      "initial_child_lease_tokens": 60000,
      "max_child_lease_tokens": 125000,
      "parent_merge_reserve_tokens": 50000,
      "reconsider_after_local_rounds": 2,
      "root_final_max_tokens": 32768,
      "root_final_output_token_budget": 50000
    },
    "legacy_archive_root": "legacy-archives",
    "limits": {
      "max_children_per_agent": 5,
      "max_concurrent_agents": 10,
      "max_elapsed_seconds": 1200.0,
      "max_fork_depth": 2,
      "max_iterations": 18,
      "max_retries_per_action": 2,
      "max_tool_calls": 30,
      "max_tool_output_chars": 24000,
      "max_total_agents": 10,
      "max_total_retries": 12,
      "max_total_tokens": 700000,
      "max_total_tool_calls": 96,
      "root_finalization_grace_seconds": 300.0
    },
    "report_review": {
      "enabled": false
    },
    "structured_report": {
      "enabled": true
    },
    "supervisor_v2": {
      "enabled": false,
      "max_citation_repair_rounds": 1,
      "max_initial_workers": 4,
      "max_red_review_rounds": 0,
      "max_research_waves": 3,
      "red_review_enabled": false
    },
    "vault_root": "memory"
  },
  "runtime": {
    "lease_seconds": 60,
    "proposal_ttl_seconds": 86400,
    "retrieval_db_path": "data/retrieval.db",
    "retrieval_reconciliation_seconds": 300,
    "semantic_embedding_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "semantic_local_files_only": true,
    "semantic_retrieval_enabled": false,
    "sweep_interval_seconds": 5,
    "terminal_retention_seconds": 604800,
    "writer_coordination_interval_seconds": 0.1
  },
  "system": {
    "log_level": "INFO",
    "name": "PaperPilot",
    "version": "0.2.0",
    "work_dir": "outputs"
  },
  "tools": {
    "enabled": [
      "acquire_evidence",
      "arxiv_reader",
      "file_reader",
      "calculator",
      "notepad"
    ],
    "evidence_acquisition": {
      "default_candidates": 8,
      "default_sources": 3,
      "max_chars_per_source": 12000,
      "max_sources": 6
    },
    "web_search": {
      "mock_mode": false
    }
  }
}
